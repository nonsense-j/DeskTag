{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only capabilities for DeskTag (global shortcuts and autostart)",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main", "calendar", "note-*"],
  "permissions": [
    "global-shortcut:default",
    "autostart:default"
  ]
}
